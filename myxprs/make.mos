model make
uses 'makeutil'

parameters
 BUILDDIR='build' ! destination directory
 SAVELOGS=false   ! whether to save logs when testing
end-parameters

if TODO="test" then
 runcmd("moseltest","LIBPATH="+BUILDDIR+"/dso","SAVELOGS="+SAVELOGS)
else
 LIBS('all'):=['xprs','xprnls']
 c2dso('myxprs.c',BUILDDIR+'/dso/')
end-if

end-model
