	 if pv<1 then
	  pv:=addnode(xd,p,XML_ELT,"entValues")
	 end-if
	 add_fctpar(pv,"entVal","value",val)
	end-do
     "doc.related":
	do
	 nid:=addnode(xd,p,XML_ELT,"entRelated")
	 text2xml(val,nid)
	end-do
    end-case
   end-if
