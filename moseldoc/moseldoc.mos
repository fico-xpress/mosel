  if sections(ndx).vn=0 then
   p:=addnode(xd,sections(ndx).bn,XML_ELT,"entity")
  else
   p:=addnode(xd,sections(ndx).vn,XML_NEXT,XML_ELT,"entity")
  end-if
  sections(ndx).vn:=p
  setsafeentname(p,v)
  setattr(xd,p,"cat","variable")
  while (l.size>0) do
   ann:=getfirst(l)
   cuthead(l,1)
   val:=getfirst(l)
   cuthead(l,1)
   if val<>"" then
    case ann of
     "doc.type":
	nid:=addnode(xd,p,XML_ELT,"entType",val)
     "doc.descr":
