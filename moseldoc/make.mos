model make
uses 'makeutil'

parameters
 BUILDDIR='build' ! destination directory
end-parameters

declarations
 lsf:list of text
end-declarations

LDFLAGS("linux")+=" -Wl,--enable-new-dtags -Wl,-rpath,$ORIGIN/../lib"
LDFLAGS("macos")+=" -Wl,-rpath,@executable_path/../lib"

if TODO='locale' then
 findfiles(lsf,'moseldoc.*.po')
 runcmd('xprnls','mogen','-d',BUILDDIR+'/locale',lsf)
elif TODO='i18n' then
 if isnewer('moseldoc.mos','moseldoc.pot') then
  runcmd('mosel','comp','-x','moseldoc.mos')
  findfiles(lsf,'moseldoc.*.po')
  runcmd('xprnls','update','-m',lsf,'moseldoc.pot')
 end-if
else
 mos2run('moseldoc.mos',BUILDDIR+'/bin/moseldoc')
end-if

end-model
